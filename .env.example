# Legacy x402 invoice service
ASP_WALLET=0x-your-x-layer-receiver-address
INVOICE_PRICE_USDT=0.50
PAYMENT_CHAIN=eip155:196
PAYMENT_VERIFY_MODE=mock
XLAYER_RPC=https://your-x-layer-rpc.example
USDT_CONTRACT=0x-your-usdt-contract-address
USDT_DECIMALS=6
USDT_NAME=USDt0
USDT_VERSION=1
MIN_CONFIRMATIONS=1
CHALLENGE_TTL=900

# Optional OKX Payment SDK
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
OKX_BASE_URL=https://web3.okx.com

# Invoice generation and persistence
INVOICE_CURRENCY=USD
TAX_RATE=0.08
DB_PATH=/tmp/invoicecraft.db
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.example
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional language model parsing
LLM_API_KEY=your-llm-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=your-model-name
LLM_API_STYLE=anthropic
LLM_API_URL=https://your-provider-endpoint.example
LLM_TIMEOUT=30
LLM_MAX_TOKENS=4096

# XRP invoice signing
XAMAN_API_KEY=your-xaman-api-key
XAMAN_API_SECRET=your-xaman-api-secret

# Phase 0 protocol proof only. Never put a seed or private key here.
XRPL_TESTNET_ADDRESS=r-your-xrpl-testnet-address
COSTON2_SIGNER_ADDRESS=0x-your-coston2-signer-address
VERIFIER_URL_TESTNET=https://verifier-testnet.flare.network
VERIFIER_API_KEY_TESTNET=your-flare-verifier-api-key
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
XRPL_TESTNET_RPC_URL=https://s.altnet.rippletest.net:51234/

# Browser-operated Coston2 queue. This is an API access token, never a wallet key.
XRP_OPERATOR_TOKEN=replace-with-a-long-random-local-token
XRP_SETTLEMENT_CONTRACT=0x-your-deployed-invoice-settlement
XRP_LIQUIDITY_ADAPTER=0x-your-deployed-test-liquidity-adapter
COSTON2_FXRP_TOKEN=0x0b6a3645c240605887a5532109323a3e12273dc7
COSTON2_USD0_TOKEN=0xc1a5b41512496b80903d1f32d6dea3a73212e71f
